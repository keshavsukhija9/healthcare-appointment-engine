generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  DOCTOR
  PATIENT
}

enum BookingStatus {
  HELD
  CONFIRMED
  CANCELLED_DUE_TO_LEAVE
  CANCELLED_BY_PATIENT
  COMPLETED
  EXPIRED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  DEAD_LETTER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile  DoctorProfile?
  patientProfile PatientProfile?
}

model DoctorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  specialization String
  workingHours   Json
  slotDurationMinutes Int @default(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bookings Booking[]
  leaves   Leave[]
}

model PatientProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id                    String        @id @default(uuid())
  doctorId              String
  doctor                DoctorProfile @relation(fields: [doctorId], references: [id])
  patientId             String
  patient               PatientProfile @relation(fields: [patientId], references: [id])
  startTime             DateTime      @db.Timestamptz(3)
  endTime               DateTime      @db.Timestamptz(3)
  status                BookingStatus @default(HELD)
  heldUntil             DateTime?     @db.Timestamptz(3)
  googleCalendarEventId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([doctorId, startTime])
}

model Leave {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([doctorId, startDate, endDate])
}

model Job {
  id             String    @id @default(uuid())
  type           String
  payload        Json
  status         JobStatus @default(PENDING)
  attemptCount   Int       @default(0)
  lockedAt       DateTime? @db.Timestamptz(3)
  workerId       String?
  runAfter       DateTime  @default(now()) @db.Timestamptz(3)
  lastError      String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}

model SymptomForm {
  id           String   @id @default(uuid())
  bookingId    String   @unique
  symptomText  String
  createdAt    DateTime @default(now())

  preVisitSummary PreVisitSummary?
}

model PreVisitSummary {
  id                String   @id @default(uuid())
  symptomFormId     String   @unique
  symptomForm       SymptomForm @relation(fields: [symptomFormId], references: [id])
  urgencyLevel      String
  chiefComplaints   Json
  suggestedQuestions Json
  source            String
  createdAt         DateTime @default(now())
}

model PostVisitNote {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  rawNotes    String
  createdAt   DateTime @default(now())

  postVisitSummary PostVisitSummary?
}

model PostVisitSummary {
  id              String   @id @default(uuid())
  postVisitNoteId String   @unique
  postVisitNote   PostVisitNote @relation(fields: [postVisitNoteId], references: [id])
  patientSummary  String
  createdAt       DateTime @default(now())
}

model Medication {
  id           String   @id @default(uuid())
  bookingId    String
  name         String
  dosage       String
  schedule     Json
  createdAt    DateTime @default(now())
}

model OAuthToken {
  id           String   @id @default(uuid())
  doctorId     String
  provider     String
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  @@unique([doctorId, provider])
}
